# Пример server-блока для nginx ЮрАгента (НЕ поднимать второй nginx на :80/:443).
#
# Куда класть (типично):
#   /opt/ur-agent/.../nginx/conf.d/urist-zaliv.ru.conf
# или volume include, как у вас уже подключены остальные сайты.
#
# Upstream: приложение слушает ТОЛЬКО на хосте 127.0.0.1:3020
# (см. docker-compose.yml проекта urist-zaliv).
# Порт 3010 занят frontend ЮрАгента — не использовать.
#
# Из контейнера nginx «localhost» — это сам nginx, не хост.
# Варианты proxy_pass (выберите один после проверки):
#   1) host.docker.internal:3020  — если в nginx-контейнере есть host-gateway
#   2) 172.17.0.1:3020           — docker0 gateway на многих Linux
#   3) urist-zaliv-web:3000      — если контейнер подключён к сети nginx (предпочтительно)
#
# Перед продом: docker network ls | grep -E 'ur-agent|nginx'
# и при необходимости: docker network connect <сеть_nginx> urist-zaliv-web

upstream urist_zaliv_upstream {
    # Замените на рабочий вариант из комментария выше
    server host.docker.internal:3020;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name urist-zaliv.ru www.urist-zaliv.ru;

    # После выпуска сертификата certbot обычно добавит listen 443 и ssl_certificate.
    # Не трогайте сертификаты ur-agent.ru.

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name urist-zaliv.ru www.urist-zaliv.ru;

    # Пути к сертификатам подставьте после certbot / вашего процесса.
    # Пример (Let's Encrypt):
    # ssl_certificate     /etc/letsencrypt/live/urist-zaliv.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/urist-zaliv.ru/privkey.pem;

    # Если используете общий сниппет SSL ЮрАгента — include его сюда.
    # include /etc/nginx/snippets/ssl-params.conf;

    client_max_body_size 4m;

    location / {
        proxy_pass http://urist_zaliv_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
